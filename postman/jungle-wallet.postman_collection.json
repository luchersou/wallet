{
  "info": {
    "name": "Jungle Wallet",
    "description": "Rode as pastas em ordem: 00 (tokens, valem 5 min) → 01 → 02 (cria a wallet) → 03 → 04 → 05 → 06.\nOs ids externos usam {{walletId}}: cada wallet nova gera ids únicos automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenUrl",
      "value": "http://localhost:8080/realms/jungle/protocol/openid-connect/token"
    },
    {
      "key": "backofficeToken",
      "value": ""
    },
    {
      "key": "providerAToken",
      "value": ""
    },
    {
      "key": "providerBToken",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "00 - Auth",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Token backoffice",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{tokenUrl}}",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "backoffice",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "backoffice-secret",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('backofficeToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token provider-a",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{tokenUrl}}",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "provider-a",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "provider-a-secret",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('providerAToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token provider-b",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{tokenUrl}}",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "provider-b",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "provider-b-secret",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('providerBToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Health & Metrics",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live"
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          }
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics"
          }
        }
      ]
    },
    {
      "name": "02 - Wallets",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{backofficeToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Criar wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('playerId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('walletId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar wallet",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{walletId}}"
          }
        },
        {
          "name": "Ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{walletId}}/ledger?limit=50"
          }
        },
        {
          "name": "Reconciliação",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{walletId}}/reconciliation"
          }
        },
        {
          "name": "Wallet duplicada (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reusa o playerId da última wallet criada: tem que dar 409."
          }
        }
      ]
    },
    {
      "name": "03 - Wagering: fluxo feliz",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{providerAToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "BET",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "provider-a:bet-{{walletId}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"bet-{{walletId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-{{walletId}}\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"25.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.transactionId) pm.collectionVariables.set('transactionId', body.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "BET de novo (replay → idempotentReplay: true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "provider-a:bet-{{walletId}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"bet-{{walletId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-{{walletId}}\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"25.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.transactionId) pm.collectionVariables.set('transactionId', body.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "WIN (referencia a BET)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "provider-a:win-{{walletId}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"win-{{walletId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-{{walletId}}\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"WIN\",\n  \"money\": {\n    \"amount\": \"50.00\",\n    \"currency\": \"BRL\"\n  },\n  \"referenceExternalTransactionId\": \"bet-{{walletId}}\"\n}",
              "options": {
