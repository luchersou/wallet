                ]
              }
            }
          ]
        },
        {
          "name": "Consultar BET pelo id do provedor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/providers/provider-a/wagering/transactions/bet-{{walletId}}"
          }
        },
        {
          "name": "Consultar última transação pelo id interno",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wagering/transactions/{{transactionId}}"
          }
        }
      ]
    },
    {
      "name": "04 - Wagering: rejeições e erros",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{providerAToken}}",
            "type": "string"
          }
        ]
      },
      "description": "Rode depois da pasta 03, com a mesma wallet.",
      "item": [
        {
          "name": "Saldo insuficiente (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
