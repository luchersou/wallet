    {
      "name": "05 - Out-of-order reference",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{providerAToken}}",
            "type": "string"
          }
        ]
      },
      "description": "Run in sequence: creates a new wallet, sends the REFUND before the BET and checks that the worker resolved it.",
      "item": [
        {
          "name": "1. Create new wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"100.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{backofficeToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('playerId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('walletId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. REFUND before the BET (202 PENDING_REFERENCE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "provider-a:early-refund-{{walletId}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"early-refund-{{walletId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-{{walletId}}\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"REFUND\",\n  \"money\": {\n    \"amount\": \"10.00\",\n    \"currency\": \"BRL\"\n  },\n  \"referenceExternalTransactionId\": \"late-bet-{{walletId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.transactionId) pm.collectionVariables.set('transactionId', body.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. BET arrives later (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "provider-a:late-bet-{{walletId}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"late-bet-{{walletId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-{{walletId}}\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"10.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.transactionId) pm.collectionVariables.set('transactionId', body.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Get the REFUND (PROCESSED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/providers/provider-a/wagering/transactions/early-refund-{{walletId}}",
            "description": "The script waits 2s before sending, so the worker can reprocess the pending transaction."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000);"
                ]
              }
            }
          ]
        }
      ]
