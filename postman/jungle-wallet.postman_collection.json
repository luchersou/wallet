        {
          "name": "Nonexistent wallet (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "provider-a:ghost-{{walletId}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"ghost-{{walletId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"00000000-0000-4000-8000-000000000000\",\n  \"roundId\": \"round-{{walletId}}\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"25.00\",\n    \"currency\": \"BRL\"\n  }\n}",
