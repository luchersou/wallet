NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=wallet
DB_PASSWORD=wallet
DB_NAME=wallet

AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=10

MIKRO_ORM_CLI_ALWAYS_ALLOW_TS=1

WORKER_PORT=3001
WORKER_AUTOSTART=true
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=60
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=25
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
SHUTDOWN_TIMEOUT_MS=20000

LOG_LEVEL=info
SERVICE_NAME=wallet

AUTH_MODE=disabled
OIDC_ISSUER=http://localhost:8080/realms/jungle
OIDC_AUDIENCE=wallet-api
OIDC_JWKS_URL=http://localhost:8080/realms/jungle/protocol/openid-connect/certs